<?xml version="1.0" encoding="utf-8"?>
<!--
  Keine Sicherung in die Cloud und keine Uebertragung auf ein neues Geraet: Eine neue
  Installation beginnt immer leer. Das Depot laesst sich ueber Profil, "Portfolio exportieren"
  und "Portfolio importieren" bewusst mitnehmen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
