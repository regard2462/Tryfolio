<?xml version="1.0" encoding="utf-8"?>
<!-- Widget „Schnellzugriff“ (seit 0.76 neu: einfarbige Symbole, bis zu zwei Zeilen mit je einer bis vier Kacheln, siehe Widgets.kt) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hintergrund"
    android:orientation="vertical"
    android:padding="5dp">

    <LinearLayout
        android:id="@+id/schnell_zeile1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/schnell1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_margin="3dp"
            android:background="@drawable/widget_kachel"
            android:padding="4dp">

            <ImageView
                android:id="@+id/schnell_bild1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/schnell_text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/schnell2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
