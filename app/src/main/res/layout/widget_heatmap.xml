<?xml version="1.0" encoding="utf-8"?>
<!-- Widget „Heatmap“ (0.68, siehe Widgets.kt) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hintergrund"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_titel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:text="@string/widget_heatmap_name"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/widget_bild"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:paddingTop="6dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_hinweis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text=""
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_stand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingTop="6dp"
        android:text=""
        android:textColor="#80FFFFFF"
        android:textSize="10sp" />
</LinearLayout>
