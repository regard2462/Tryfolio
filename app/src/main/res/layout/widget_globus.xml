<?xml version="1.0" encoding="utf-8"?>
<!-- Widget „Globus“ (0.69, siehe Widgets.kt): das Bild fuellt das ganze Widget, Hinweis und Stand liegen darauf -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
