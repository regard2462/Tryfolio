    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/widget_bild"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_globus_vorschau" />
    <!-- Wischbarer Stapel (0.77, ab Android 12): jede Ansicht dreht 30 Grad weiter. Er ist um ein Neuntel groesser als
         das Widget und nach oben rechts hinausgeschoben, damit die vorderste Ansicht das Widget genau fuellt -->
    <StackView
        android:id="@+id/globus_stapel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true"
        android:visibility="gone" />

