<?xml version="1.0" encoding="utf-8"?>
<!-- Widget „Globus“ (0.69, siehe Widgets.kt): das Bild fuellt das ganze Widget, Hinweis und Stand liegen darauf -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/widget_bild"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_globus_vorschau" />

    <TextView
        android:id="@+id/widget_hinweis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:padding="14dp"
        android:text=""
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_stand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:maxLines="1"
        android:padding="8dp"
        android:text=""
        android:textColor="#B3FFFFFF"
        android:textSize="10sp" />
</FrameLayout>
