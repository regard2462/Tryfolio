{"version": 1, "stand": "2026-09", "module": [{"id": "m01", "nr": 1, "titel": "Geld, Zins und Zeit", "unter": "Zins, Rendite, Risiko, Inflation und Kosten", "beschreibung": "Zins, Zinseszins, Rendite, Risiko, Inflation, Barwert und Kosten sind die Grundbegriffe, mit denen sich fast jedes Finanzprodukt beschreiben lässt. Die Lektionen führen sie mit Rechenbeispielen ein.", "stufe": "Grundlagen", "lektionen": [{"id": "m01-l01", "titel": "Geld, Zeit und Zins", "minuten": 8, "stufe": "Grundlagen"}, {"id": "m01-l02", "titel": "Zinseszins", "minuten": 10, "stufe": "Grundlagen"}, {"id": "m01-l03", "titel": "Die 72er-Regel und andere Kopfrechenhilfen", "minuten": 7, "stufe": "Grundlagen"}, {"id": "m01-l04", "titel": "Renditearten", "minuten": 11, "stufe": "Aufbau"}, {"id": "m01-l05", "titel": "Risiko und Volatilität", "minuten": 11, "stufe": "Aufbau"}, {"id": "m01-l06", "titel": "Verlustarithmetik", "minuten": 8, "stufe": "Aufbau"}, {"id": "m01-l07", "titel": "Inflation und Kaufkraft", "minuten": 10, "stufe": "Grundlagen"}, {"id": "m01-l08", "titel": "Barwert und Opportunitätskosten", "minuten": 10, "stufe": "Aufbau"}, {"id": "m01-l09", "titel": "Kosten", "minuten": 10, "stufe": "Grundlagen"}, {"id": "m01-l10", "titel": "Überblick über Anlageprodukte", "minuten": 11, "stufe": "Grundlagen"}]}, {"id": "m02", "nr": 2, "titel": "Persönliche Finanzen ordnen", "unter": "Überblick, Notgroschen, Schulden und Versicherungen", "beschreibung": "Vor der ersten Geldanlage stehen ein Überblick über Einnahmen und Ausgaben, ein Notgroschen, der Abbau teurer Schulden und die wichtigen Versicherungen. Die Lektionen gehen diese Schritte der Reihe nach durch, bis zu Steuern, Bonität und finanzieller Unabhängigkeit.", "stufe": "Grundlagen", "lektionen": [{"id": "m02-l01", "titel": "Reihenfolge beim Vermögensaufbau", "minuten": 9, "stufe": "Grundlagen"}, {"id": "m02-l02", "titel": "Einnahmen, Ausgaben und Vermögen", "minuten": 10, "stufe": "Grundlagen"}, {"id": "m02-l03", "titel": "Der Notgroschen", "minuten": 8, "stufe": "Grundlagen"}, {"id": "m02-l04", "titel": "Schulden und Tilgung", "minuten": 11, "stufe": "Grundlagen"}, {"id": "m02-l05", "titel": "Notwendige und verzichtbare Versicherungen", "minuten": 12, "stufe": "Grundlagen"}, {"id": "m02-l06", "titel": "Der Wert der Arbeitskraft", "minuten": 9, "stufe": "Aufbau"}, {"id": "m02-l07", "titel": "Brutto, Netto und Grenzsteuersatz", "minuten": 11, "stufe": "Aufbau"}, {"id": "m02-l08", "titel": "Kosten des Konsums", "minuten": 9, "stufe": "Grundlagen"}, {"id": "m02-l09", "titel": "Bonität, Schufa und finanzielle Ordnung", "minuten": 8, "stufe": "Aufbau"}, {"id": "m02-l10", "titel": "Finanzielle Unabhängigkeit berechnen", "minuten": 11, "stufe": "Aufbau"}, {"id": "m02-l11", "titel": "Partnerschaft, Kinder und Erbe", "minuten": 10, "stufe": "Aufbau"}]}, {"id": "m03", "nr": 3, "titel": "Das Geldsystem", "unter": "Wie Geld entsteht und was Zentralbanken tun", "beschreibung": "Geldschöpfung, Zentralbanken, Inflation, Zinsen, Staatsschulden, Währungen, Gold, Banken und Kryptogeld. Wer diese Zusammenhänge kennt, kann Nachrichten über Leitzinsen und Inflation einordnen.", "stufe": "Aufbau", "lektionen": [{"id": "m03-l01", "titel": "Was Geld ist", "minuten": 9, "stufe": "Grundlagen"}, {"id": "m03-l02", "titel": "Wie Geld entsteht", "minuten": 11, "stufe": "Aufbau"}, {"id": "m03-l03", "titel": "Ziele und Instrumente der Zentralbanken", "minuten": 11, "stufe": "Aufbau"}, {"id": "m03-l04", "titel": "Ursachen von Inflation und Deflation", "minuten": 11, "stufe": "Aufbau"}, {"id": "m03-l05", "titel": "Zinsen und ihre Wirkung", "minuten": 10, "stufe": "Aufbau"}, {"id": "m03-l06", "titel": "Staatsschulden", "minuten": 11, "stufe": "Aufbau"}, {"id": "m03-l07", "titel": "Währungen und Wechselkurse", "minuten": 10, "stufe": "Aufbau"}, {"id": "m03-l08", "titel": "Goldstandard und Goldanlage", "minuten": 10, "stufe": "Aufbau"}, {"id": "m03-l09", "titel": "Geschäftsmodell und Risiken der Banken", "minuten": 11, "stufe": "Aufbau"}, {"id": "m03-l10", "titel": "Kryptogeld", "minuten": 12, "stufe": "Aufbau"}]}, {"id": "m04", "nr": 4, "titel": "Märkte und Instrumente", "unter": "Börsen, Depot, Orderarten und Kosten", "beschreibung": "Wie eine Börse arbeitet, wie Depot und Order funktionieren, welche Instrumente es gibt und welche Kosten beim Handel anfallen. Dazu die typischen Betrugsmaschen und das Geschäftsmodell der Finanzbranche.", "stufe": "Grundlagen", "lektionen": [{"id": "m04-l01", "titel": "Aufgaben einer Börse", "minuten": 9, "stufe": "Grundlagen"}, {"id": "m04-l02", "titel": "Depot und Broker", "minuten": 11, "stufe": "Grundlagen"}, {"id": "m04-l03", "titel": "Die erste Order Schritt für Schritt", "minuten": 10, "stufe": "Grundlagen"}, {"id": "m04-l04", "titel": "Aktien als Instrument", "minuten": 10, "stufe": "Grundlagen"}, {"id": "m04-l05", "titel": "Rechtsform von Fonds und ETFs", "minuten": 11, "stufe": "Grundlagen"}, {"id": "m04-l06", "titel": "Anleihen, Zertifikate und Derivate", "minuten": 10, "stufe": "Grundlagen"}, {"id": "m04-l07", "titel": "Indizes verstehen", "minuten": 11, "stufe": "Aufbau"}, {"id": "m04-l08", "titel": "Rohstoffe, Immobilien und Sachwerte", "minuten": 10, "stufe": "Aufbau"}, {"id": "m04-l09", "titel": "Kosten einer Wertpapierorder", "minuten": 9, "stufe": "Aufbau"}, {"id": "m04-l10", "titel": "Anlagebetrug und Abzocke erkennen", "minuten": 11, "stufe": "Grundlagen"}, {"id": "m04-l11", "titel": "Das Geschäftsmodell der Finanzbranche", "minuten": 10, "stufe": "Aufbau"}]}, {"id": "m05", "nr": 5, "titel": "Anleihen und Zinsen", "unter": "Kurs, Rendite, Laufzeit und Bonität", "beschreibung": "Wie Anleihen rechnen: Kupon, Kurs und Rendite, Duration, Zinsstrukturkurve und Ausfallrisiko. Der Zins sicherer Anleihen dient außerdem als Maßstab für die Bewertung von Aktien und Immobilien.", "stufe": "Aufbau", "lektionen": [{"id": "m05-l01", "titel": "Aufbau einer Anleihe", "minuten": 9, "stufe": "Grundlagen"}, {"id": "m05-l02", "titel": "Kurs und Rendite", "minuten": 11, "stufe": "Aufbau"}, {"id": "m05-l03", "titel": "Duration und Konvexität", "minuten": 12, "stufe": "Profi"}, {"id": "m05-l04", "titel": "Die Zinsstrukturkurve", "minuten": 11, "stufe": "Aufbau"}, {"id": "m05-l05", "titel": "Bonität, Spreads und Ausfall", "minuten": 11, "stufe": "Aufbau"}, {"id": "m05-l06", "titel": "Anleihearten im Überblick", "minuten": 10, "stufe": "Aufbau"}, {"id": "m05-l07", "titel": "Anleihen im Portfolio", "minuten": 11, "stufe": "Aufbau"}, {"id": "m05-l08", "titel": "Der Zins als Bewertungsgrundlage", "minuten": 10, "stufe": "Profi"}, {"id": "m05-l09", "titel": "Geldmarkt und Cash", "minuten": 9, "stufe": "Grundlagen"}]}, {"id": "m06", "nr": 6, "titel": "Aktien verstehen", "unter": "Vom Unternehmen zur Aktie", "beschreibung": "Eine Aktie ist ein Anteil an einem Unternehmen. Die Lektionen verbinden Bilanz, Gewinn- und Verlustrechnung, Cashflow und Geschäftsmodell mit dem Kurs an der Börse und enden mit einer Prüfliste für einzelne Aktien.", "stufe": "Aufbau", "lektionen": [{"id": "m06-l01", "titel": "Die Aktie als Unternehmensanteil", "minuten": 9, "stufe": "Grundlagen"}, {"id": "m06-l02", "titel": "Die Bilanz lesen", "minuten": 12, "stufe": "Aufbau"}, {"id": "m06-l03", "titel": "Gewinn- und Verlustrechnung", "minuten": 11, "stufe": "Aufbau"}, {"id": "m06-l04", "titel": "Cashflow und Kapitalflussrechnung", "minuten": 11, "stufe": "Aufbau"}, {"id": "m06-l05", "titel": "Kennzahlen und ihre Grenzen", "minuten": 12, "stufe": "Aufbau"}, {"id": "m06-l06", "titel": "Geschäftsmodelle und Burggräben", "minuten": 12, "stufe": "Aufbau"}, {"id": "m06-l07", "titel": "Kapitalallokation", "minuten": 11, "stufe": "Profi"}, {"id": "m06-l08", "titel": "Dividenden richtig einordnen", "minuten": 11, "stufe": "Aufbau"}, {"id": "m06-l09", "titel": "Verwässerung und Aktienvergütung", "minuten": 10, "stufe": "Profi"}, {"id": "m06-l10", "titel": "Warnsignale in Geschäftsberichten", "minuten": 12, "stufe": "Profi"}, {"id": "m06-l11", "titel": "Aktien-Vorprüfung in zwei Stunden", "minuten": 11, "stufe": "Aufbau"}]}, {"id": "m07", "nr": 7, "titel": "Unternehmensbewertung", "unter": "Multiples, DCF und ihre Grenzen", "beschreibung": "Multiples, Discounted-Cashflow-Modelle, Kapitalkosten und Scorings. Jede Methode beruht auf Schätzungen, und die Lektionen zeigen, wie stark das Ergebnis auf geänderte Annahmen reagiert.", "stufe": "Profi", "lektionen": [{"id": "m07-l01", "titel": "Preis und Wert", "minuten": 9, "stufe": "Aufbau"}, {"id": "m07-l02", "titel": "Bewertung mit Multiples", "minuten": 11, "stufe": "Aufbau"}, {"id": "m07-l03", "titel": "Discounted Cash Flow Schritt für Schritt", "minuten": 13, "stufe": "Profi"}, {"id": "m07-l04", "titel": "Kapitalkosten, WACC und CAPM", "minuten": 12, "stufe": "Profi"}, {"id": "m07-l05", "titel": "Reverse DCF", "minuten": 10, "stufe": "Profi"}, {"id": "m07-l06", "titel": "ROIC, WACC und Wertschaffung", "minuten": 11, "stufe": "Profi"}, {"id": "m07-l07", "titel": "Graham-Bewertung und Net-Nets", "minuten": 10, "stufe": "Aufbau"}, {"id": "m07-l08", "titel": "Piotroski-, Altman- und Beneish-Score", "minuten": 11, "stufe": "Profi"}, {"id": "m07-l09", "titel": "Bewertung von Sonderfällen", "minuten": 11, "stufe": "Profi"}, {"id": "m07-l10", "titel": "Bewertung in der Praxis", "minuten": 12, "stufe": "Profi"}, {"id": "m07-l11", "titel": "Die häufigsten Bewertungsfehler", "minuten": 10, "stufe": "Profi"}]}, {"id": "m08", "nr": 8, "titel": "Portfolio und Risiko", "unter": "Diversifikation, Allokation und Rebalancing", "beschreibung": "Die Aufteilung auf Anlageklassen bestimmt einen großen Teil von Rendite und Schwankung eines Depots. Behandelt werden Streuung, Korrelation, Risikokennzahlen, Faktoren, Rebalancing und Währungsrisiko.", "stufe": "Aufbau", "lektionen": [{"id": "m08-l01", "titel": "Diversifikation", "minuten": 11, "stufe": "Grundlagen"}, {"id": "m08-l02", "titel": "Korrelation und Portfoliorisiko", "minuten": 11, "stufe": "Aufbau"}, {"id": "m08-l03", "titel": "Markowitz und die Effizienzkurve", "minuten": 12, "stufe": "Profi"}, {"id": "m08-l04", "titel": "CAPM, Beta und Alpha", "minuten": 11, "stufe": "Profi"}, {"id": "m08-l05", "titel": "Kennzahlen für Risiko und Ergebnis", "minuten": 11, "stufe": "Aufbau"}, {"id": "m08-l06", "titel": "Die Allokation festlegen", "minuten": 12, "stufe": "Aufbau"}, {"id": "m08-l07", "titel": "Das Weltportfolio", "minuten": 12, "stufe": "Aufbau"}, {"id": "m08-l08", "titel": "Faktorprämien", "minuten": 12, "stufe": "Profi"}, {"id": "m08-l09", "titel": "Rebalancing", "minuten": 11, "stufe": "Aufbau"}, {"id": "m08-l10", "titel": "Währungsrisiko und Hedging", "minuten": 10, "stufe": "Profi"}, {"id": "m08-l11", "titel": "Ansparen und Entnehmen im Lebenszyklus", "minuten": 11, "stufe": "Aufbau"}]}, {"id": "m09", "nr": 9, "titel": "ETFs und passives Investieren", "unter": "Indexfonds verstehen und auswählen", "beschreibung": "Warum Indexfonds für viele Anleger gut geeignet sind, wie ETFs technisch funktionieren, was sie kosten und nach welchen Merkmalen man einen ETF auswählt.", "stufe": "Grundlagen", "lektionen": [{"id": "m09-l01", "titel": "Die Idee des Indexfonds", "minuten": 10, "stufe": "Grundlagen"}, {"id": "m09-l02", "titel": "Funktionsweise eines ETF", "minuten": 11, "stufe": "Aufbau"}, {"id": "m09-l03", "titel": "Replikationsarten bei ETFs", "minuten": 11, "stufe": "Aufbau"}, {"id": "m09-l04", "titel": "Kosten und Tracking", "minuten": 11, "stufe": "Aufbau"}, {"id": "m09-l05", "titel": "Ausschüttend oder thesaurierend", "minuten": 10, "stufe": "Aufbau"}, {"id": "m09-l06", "titel": "Einen ETF auswählen", "minuten": 12, "stufe": "Grundlagen"}, {"id": "m09-l07", "titel": "Sparplan einrichten und durchhalten", "minuten": 10, "stufe": "Grundlagen"}, {"id": "m09-l08", "titel": "Spezial-ETFs und ihre Risiken", "minuten": 12, "stufe": "Aufbau"}, {"id": "m09-l09", "titel": "Die Passiv-Blasen-These", "minuten": 10, "stufe": "Profi"}, {"id": "m09-l10", "titel": "Core und Satellit", "minuten": 10, "stufe": "Aufbau"}, {"id": "m09-l11", "titel": "Anlagepolitik in fünf Zeilen", "minuten": 11, "stufe": "Grundlagen"}]}, {"id": "m10", "nr": 10, "titel": "Aktive Strategien", "unter": "Value, Growth, Dividende, Momentum und weitere", "beschreibung": "Die bekannten Anlagestile mit ihren Regeln, historischen Ergebnissen und Schwächephasen, dazu der Aufwand, den aktives Investieren verlangt.", "stufe": "Aufbau", "lektionen": [{"id": "m10-l01", "titel": "Value Investing", "minuten": 12, "stufe": "Aufbau"}, {"id": "m10-l02", "titel": "Quality und Compounder", "minuten": 11, "stufe": "Aufbau"}, {"id": "m10-l03", "titel": "Growth und Bewertung", "minuten": 11, "stufe": "Aufbau"}, {"id": "m10-l04", "titel": "Dividendenstrategien", "minuten": 11, "stufe": "Aufbau"}, {"id": "m10-l05", "titel": "Nebenwerte und Small Caps", "minuten": 10, "stufe": "Aufbau"}, {"id": "m10-l06", "titel": "Sondersituationen", "minuten": 11, "stufe": "Profi"}, {"id": "m10-l07", "titel": "Momentum und Trendfolge", "minuten": 11, "stufe": "Profi"}, {"id": "m10-l08", "titel": "Quantitative und regelbasierte Ansätze", "minuten": 11, "stufe": "Profi"}, {"id": "m10-l09", "titel": "Contrarian und Antizyklik", "minuten": 11, "stufe": "Aufbau"}, {"id": "m10-l10", "titel": "Anforderungen an aktives Investieren", "minuten": 11, "stufe": "Aufbau"}]}, {"id": "m11", "nr": 11, "titel": "Börsenpsychologie", "unter": "Denkfehler beim Anlegen", "beschreibung": "Anleger erzielen im Durchschnitt weniger Rendite als die Fonds, in die sie investieren. Die Lektionen erklären die Denkfehler dahinter und Regeln, die dagegen helfen.", "stufe": "Grundlagen", "lektionen": [{"id": "m11-l01", "titel": "Schnelles und langsames Denken", "minuten": 10, "stufe": "Grundlagen"}, {"id": "m11-l02", "titel": "Verlustaversion und Prospect Theory", "minuten": 11, "stufe": "Grundlagen"}, {"id": "m11-l03", "titel": "Overconfidence und häufiges Handeln", "minuten": 11, "stufe": "Grundlagen"}, {"id": "m11-l04", "titel": "Herdenverhalten, Narrative und FOMO", "minuten": 11, "stufe": "Grundlagen"}, {"id": "m11-l05", "titel": "Anker, Framing und Mental Accounting", "minuten": 11, "stufe": "Aufbau"}, {"id": "m11-l06", "titel": "Rückschau, Bestätigung und Selbsttäuschung", "minuten": 11, "stufe": "Aufbau"}, {"id": "m11-l07", "titel": "Mungers Katalog der Denkfehler", "minuten": 13, "stufe": "Profi"}, {"id": "m11-l08", "titel": "Die Verhaltenslücke in Zahlen", "minuten": 10, "stufe": "Aufbau"}, {"id": "m11-l09", "titel": "Verhalten im Crash", "minuten": 11, "stufe": "Grundlagen"}, {"id": "m11-l10", "titel": "Regeln gegen Denkfehler", "minuten": 11, "stufe": "Aufbau"}, {"id": "m11-l11", "titel": "Geld und Gefühl", "minuten": 10, "stufe": "Grundlagen"}]}, {"id": "m12", "nr": 12, "titel": "Markteffizienz und Evidenz", "unter": "Was Studien über Märkte zeigen", "beschreibung": "Wie schnell Märkte Informationen verarbeiten und was empirische Studien über Anomalien, aktive Fonds, Prognosen und alternative Anlagen zeigen.", "stufe": "Profi", "lektionen": [{"id": "m12-l01", "titel": "Die Effizienzmarkthypothese", "minuten": 11, "stufe": "Aufbau"}, {"id": "m12-l02", "titel": "Anomalien und ihr Rückgang", "minuten": 11, "stufe": "Profi"}, {"id": "m12-l03", "titel": "Aktiv und passiv im Vergleich", "minuten": 12, "stufe": "Aufbau"}, {"id": "m12-l04", "titel": "Survivorship Bias und andere Verzerrungen", "minuten": 11, "stufe": "Profi"}, {"id": "m12-l05", "titel": "Prognosen und ihre Trefferquote", "minuten": 11, "stufe": "Aufbau"}, {"id": "m12-l06", "titel": "Kompetenz oder Glück", "minuten": 11, "stufe": "Profi"}, {"id": "m12-l07", "titel": "Hedgefonds und Private Equity", "minuten": 11, "stufe": "Profi"}, {"id": "m12-l08", "titel": "Evidenz und Anlageentscheidungen", "minuten": 10, "stufe": "Aufbau"}]}, {"id": "m13", "nr": 13, "titel": "Zyklen, Krisen, Geldgeschichte", "unter": "Blasen und Krisen seit dem 17. Jahrhundert", "beschreibung": "Von der Tulpenmanie bis zur Zinswende. Die Lektionen beschreiben die großen Krisen und die Muster, die sich in Übertreibung, Absturz und Erholung wiederholen.", "stufe": "Aufbau", "lektionen": [{"id": "m13-l01", "titel": "Phasen einer Spekulationsblase", "minuten": 11, "stufe": "Aufbau"}, {"id": "m13-l02", "titel": "Tulpenmanie, Mississippi- und Südseeblase", "minuten": 10, "stufe": "Aufbau"}, {"id": "m13-l03", "titel": "1929 und die Weltwirtschaftskrise", "minuten": 11, "stufe": "Aufbau"}, {"id": "m13-l04", "titel": "Hyperinflation 1923", "minuten": 10, "stufe": "Aufbau"}, {"id": "m13-l05", "titel": "Inflation, Öl und Zinsen 1971–1982", "minuten": 11, "stufe": "Aufbau"}, {"id": "m13-l06", "titel": "Schwarzer Montag 1987 und Japan-Blase", "minuten": 11, "stufe": "Aufbau"}, {"id": "m13-l07", "titel": "Die Dotcom-Blase 1995 bis 2003", "minuten": 11, "stufe": "Aufbau"}, {"id": "m13-l08", "titel": "Die Finanzkrise 2008", "minuten": 13, "stufe": "Aufbau"}, {"id": "m13-l09", "titel": "Euro-Krise und Negativzinsen", "minuten": 11, "stufe": "Aufbau"}, {"id": "m13-l10", "titel": "Corona 2020 und Zinswende 2022", "minuten": 11, "stufe": "Aufbau"}, {"id": "m13-l11", "titel": "Banken, KI und Zinsen 2023–2026", "minuten": 11, "stufe": "Aufbau"}, {"id": "m13-l12", "titel": "Lehren aus den Krisen", "minuten": 11, "stufe": "Aufbau"}]}, {"id": "m14", "nr": 14, "titel": "Trading und technische Analyse", "unter": "Werkzeuge, Studien und Ergebnisse", "beschreibung": "Chartanalyse, Indikatoren, Risikomanagement und Backtesting, dazu Studien darüber, wie viele Privatanleger mit aktivem Handel Geld verdienen.", "stufe": "Aufbau", "lektionen": [{"id": "m14-l01", "titel": "Charts lesen", "minuten": 10, "stufe": "Grundlagen"}, {"id": "m14-l02", "titel": "Trend, Unterstützung und Widerstand", "minuten": 10, "stufe": "Grundlagen"}, {"id": "m14-l03", "titel": "Indikatoren und ihre Mathematik", "minuten": 12, "stufe": "Aufbau"}, {"id": "m14-l04", "titel": "Chartformationen und Studienlage", "minuten": 11, "stufe": "Aufbau"}, {"id": "m14-l05", "titel": "Risikomanagement und Positionsgröße", "minute